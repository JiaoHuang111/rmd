# Copy to `.env` and edit as needed. `.env` is gitignored; never commit real
# credentials. Every key here is optional -- all of them have a working default.
#
# .env is read by train.py and test.py at startup. The eval_csp scripts read the
# same variables from the environment, so `export`ing them works too.

# ---------------------------------------------------------------------------
# Training / validation / testing
# ---------------------------------------------------------------------------

# Repository root. Determines where logs and checkpoints are written, because
# configs/paths/default.yaml resolves ${oc.env:PROJECT_ROOT}.
# Defaults to the directory containing train.py / test.py.
# PROJECT_ROOT=/path/to/this/repo

# ---------------------------------------------------------------------------
# eval_csp (CSP benchmark)
# ---------------------------------------------------------------------------

# Path to a CrystaLLM checkout, read-only. The benchmark CSVs at
# resources/benchmarks/<ds>/{train,val,test}.csv are third-party data and are
# not bundled here, so this must be set before running the data-preparation
# scripts (prepare_test_data.py, prepare_gt.py, preprocess_test.py --validate,
# validate_prep*.py).
# CRYSTALLM_ROOT=/path/to/CrystaLLM-main

# Override the tokenized-corpus directory used by the eval scripts. Useful when
# the tokenized data lives outside the checkout. Defaults to
# <repo>/data-bin/crystalmols/tokens_<ds>.
# EVAL_TOKENS_DIR=/path/to/tokens_mp_20

# Device for sanity_checks_csp.py. Defaults to cuda when available, else cpu.
# SANITY_DEVICE=cpu
